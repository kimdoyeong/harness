{
  "name": "harness",
  "version": "0.1.0",
  "private": true,
  "description": "ai-sdlc 스킬, docs 뼈대, AGENTS.md를 프로젝트에 만들어 주는 CLI",
  "type": "module",
  "bin": {
    "harness": "bin/harness.ts"
  },
  "engines": {
    "node": "^22.18.0 || >=23.6.0"
  },
  "packageManager": "pnpm@12.21.0",
